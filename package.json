{
  "name": "oct-baremetal",
  "version": "0.1.0",
  "description": "Community project. Unofficial OpenShift Console UX enhancements. Not officially supported by Red Hat.",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production yarn webpack",
    "build-dev": "yarn clean && yarn webpack",
    "start": "yarn webpack serve",
    "start-console": "./start-console.sh",
    "lint": "eslint src --fix --max-warnings 0",
    "ts-check": "tsc --noEmit",
    "webpack": "webpack --config webpack.config.js"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.21.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.21.0",
    "@patternfly/react-core": "^6.0.0",
    "@patternfly/react-icons": "^6.0.0",
    "@patternfly/react-table": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^18.0.0",
    "@types/react": "^17.0.0",
    "@types/react-router-dom": "^5.3.3",
    "css-loader": "^6.10.0",
    "i18next": "^21.10.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-i18next": "^11.18.6",
    "react-router": "5.3.4",
    "react-router-dom": "^5.3.4",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "consolePlugin": {
    "name": "oct-baremetal",
    "version": "0.1.0",
    "displayName": "Bare Metal Hosts",
    "description": "Community project. Bare Metal Hosts Console plugin (inventory, register, deploy). Not officially supported by Red Hat.",
    "exposedModules": {
      "BaremetalNodesPage": "./components/BaremetalNodesPage",
      "DeployPage": "./components/DeployPage",
      "RegisterWizardPage": "./components/RegisterWizardPage"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "packageManager": "yarn@4.17.1",
  "dependencies": {
    "ajv": "^8.20.0",
    "file-selector": "^4.0.2",
    "js-yaml": "^5.2.2",
    "tslib": "^2.8.1"
  }
}
